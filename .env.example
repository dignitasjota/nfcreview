# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=reviewtap
POSTGRES_USER=reviewtap
POSTGRES_PASSWORD=cambia-esta-contrasena

# ── Backend ───────────────────────────────────────────────────────────────────
# prod: sin datos demo. dev: seed con negocio "Barbería Demo" e interacciones históricas.
SPRING_PROFILES_ACTIVE=prod

# Clave de firma de las cookies de sesión (mínimo 32 bytes). Generar con: openssl rand -base64 48
JWT_SECRET=

# URL pública de los dispositivos, SIN barra final. Se imprime en tarjetas y QR: no cambiarla después.
PUBLIC_BASE_URL=https://r.midominio.com

# Orígenes permitidos para CORS. Vacío si el frontend proxifica /api (configuración por defecto).
# Sólo necesario si sirves la API en un dominio distinto al de la app, p. ej. https://app.midominio.com
CORS_ALLOWED_ORIGINS=

# true en producción (HTTPS). false sólo para probar en http://localhost.
COOKIE_SECURE=true

# Primer administrador: se crea en el primer arranque si no existe ningún ADMIN. Luego puedes borrar estas líneas.
APP_BOOTSTRAP_ADMIN_EMAIL=admin@midominio.com
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Swagger UI en /api/docs/ui (desactivado en producción por defecto).
SWAGGER_UI_ENABLED=false

# ── Puertos publicados (sólo localhost; el reverse proxy los expone) ──────────
BACKEND_PORT=127.0.0.1:8080
FRONTEND_PORT=127.0.0.1:8081
LANDING_PORT=127.0.0.1:8082
# Nombre de la red docker compartida con Nginx Proxy Manager (si aplica).
PROXY_NETWORK=reviewtap-proxy
